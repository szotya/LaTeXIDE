<Window x:Class="LaTeXIDE.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" Title="LaTeX IDE">
 <Grid x:Name="Root" Background="{ThemeResource IdeChromeBrush}" KeyDown="WorkspaceKeyDown">
  <Grid.Resources>
   <SolidColorBrush x:Key="IdeChromeBrush" Color="#191B22"/><SolidColorBrush x:Key="IdeSidebarBrush" Color="#232630"/>
   <SolidColorBrush x:Key="IdeEditorBrush" Color="#1D2028"/><SolidColorBrush x:Key="IdePanelBrush" Color="#20232C"/>
   <SolidColorBrush x:Key="IdeBorderBrush" Color="#343947"/><SolidColorBrush x:Key="IdeSelectionBrush" Color="#354567"/>
   <SolidColorBrush x:Key="IdeCurrentLineBrush" Color="#262B37"/><SolidColorBrush x:Key="IdeHoverBrush" Color="#2D3341"/>
   <SolidColorBrush x:Key="IdeTextBrush" Color="#DCE3F0"/><SolidColorBrush x:Key="IdeSecondaryBrush" Color="#A5B0C5"/>
   <SolidColorBrush x:Key="IdeAccentBrush" Color="#9BA9FF"/><SolidColorBrush x:Key="IdeSuccessBrush" Color="#8CD7B4"/>
   <SolidColorBrush x:Key="IdeWarningBrush" Color="#F0C080"/><SolidColorBrush x:Key="IdeErrorBrush" Color="#F29DAD"/>
   <Style TargetType="Button"><Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{ThemeResource IdeTextBrush}"/><Setter Property="CornerRadius" Value="4"/></Style>
   <Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource IdeTextBrush}"/></Style>
   <Style TargetType="TextBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,3"/><Setter Property="Background" Value="{ThemeResource IdeEditorBrush}"/><Setter Property="Foreground" Value="{ThemeResource IdeTextBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource IdeBorderBrush}"/><Setter Property="CornerRadius" Value="4"/></Style>
   <Style x:Key="RailButton" TargetType="Button" ><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource IdeSecondaryBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
  <Border BorderBrush="{ThemeResource IdeBorderBrush}" BorderThickness="0,0,0,1">
   <Grid Padding="8,4" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="ProjectButton" Click="OpenProject" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Helyi projektmappa megnyitása"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource IdeAccentBrush}"/><TextBlock x:Name="ProjectLabel" Text="Projekt megnyitása…" TextTrimming="CharacterEllipsis" MaxWidth="174"/></StackPanel></Button>
    <Button Grid.Column="1" Click="QuickOpen" MaxWidth="380" HorizontalAlignment="Stretch" Background="{ThemeResource IdeEditorBrush}" BorderBrush="{ThemeResource IdeBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="Fájlnév szerinti gyors megnyitás · Ctrl+P"><Grid MinWidth="140"><TextBlock Text="Fájl keresése…" Foreground="{ThemeResource IdeSecondaryBrush}"/><TextBlock Text="Ctrl+P" HorizontalAlignment="Right" Foreground="{ThemeResource IdeSecondaryBrush}" Margin="120,0,0,0"/></Grid></Button>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
     <TextBox x:Name="MainFile" Text="main.tex" Width="138" AutomationProperties.Name="Fordítandó fődokumentum" ToolTipService.ToolTip="A fordítandó fődokumentum relatív útvonala"/>
     <Button x:Name="BuildButton" Content="▶ Fordítás" Click="Build" Foreground="{ThemeResource IdeSuccessBrush}" IsEnabled="False" ToolTipService.ToolTip="Mentés és fordítás · Ctrl+B"/><Button x:Name="CancelButton" Click="Cancel" IsEnabled="False" ToolTipService.ToolTip="Fordítás leállítása" AutomationProperties.Name="Fordítás leállítása"><FontIcon Glyph="&#xE71A;" FontSize="12"/></Button>
     <Button x:Name="CommandButton" Content="Műveletek" ToolTipService.ToolTip="Műveletek · Ctrl+Shift+P"><Button.Flyout><MenuFlyout x:Name="CommandFlyout"><MenuFlyoutItem Text="Projekt megnyitása…" Click="OpenProject"/><MenuFlyoutItem Text="Összes módosítás mentése" Click="Save"/><MenuFlyoutItem Text="Visszavonás" Click="Undo"/><MenuFlyoutItem Text="Újra" Click="Redo"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Keresés a forrásban" Click="ShowFind"/><MenuFlyoutItem Text="Projektpanel mutatása / elrejtése" Click="ToggleSidebar"/><MenuFlyoutItem Text="PDF mutatása / elrejtése" Click="TogglePreview"/><MenuFlyoutItem Text="Kimenet mutatása / elrejtése" Click="ToggleOutput"/></MenuFlyout></Button.Flyout></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition x:Name="SidebarDividerColumn" Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{ThemeResource IdeBorderBrush}" BorderThickness="0,0,1,0"><Grid><StackPanel Spacing="4" Margin="3,8"><Button x:Name="ProjectRail" Style="{StaticResource RailButton}" Click="ShowProject" ToolTipService.ToolTip="Projekt" AutomationProperties.Name="Projektpanel"><FontIcon Glyph="&#xE8B7;" FontSize="18"/></Button><Button x:Name="SearchRail" Style="{StaticResource RailButton}" Click="QuickOpen" ToolTipService.ToolTip="Fájlnévszűrés · Ctrl+P" AutomationProperties.Name="Fájlnévszűrés"><FontIcon Glyph="&#xE721;" FontSize="18"/></Button><Button x:Name="AgentRail" Style="{StaticResource RailButton}" Click="ShowAgent" ToolTipService.ToolTip="Helyi agent / MCP" AutomationProperties.Name="Helyi MCP panel"><FontIcon Glyph="&#xE8F2;" FontSize="18"/></Button></StackPanel>
    <Button x:Name="AppearanceButton" Style="{StaticResource RailButton}" VerticalAlignment="Bottom" Margin="3,0,3,8" ToolTipService.ToolTip="Megjelenés" AutomationProperties.Name="Megjelenés"><FontIcon Glyph="&#xE790;" FontSize="18"/><Button.Flyout><Flyout><StackPanel Width="250" Spacing="10"><TextBlock Text="MEGJELENÉS" FontWeight="SemiBold"/><TextBlock Text="Paletta"/><ComboBox x:Name="PaletteChoice" HorizontalAlignment="Stretch" SelectionChanged="AppearanceChanged"/><TextBlock Text="Világos / sötét mód"/><ComboBox x:Name="ModeChoice" HorizontalAlignment="Stretch" SelectionChanged="AppearanceChanged"><ComboBoxItem Content="Rendszer követése" Tag="system"/><ComboBoxItem Content="Világos" Tag="light"/><ComboBoxItem Content="Sötét" Tag="dark"/></ComboBox><TextBlock Text="A paletta és a mód helyben, felhasználónként megmarad." TextWrapping="Wrap" Foreground="{ThemeResource IdeSecondaryBrush}"/></StackPanel></Flyout></Button.Flyout></Button>
   </Grid></Border>
   <Grid x:Name="Sidebar" Grid.Column="1" Background="{ThemeResource IdeSidebarBrush}"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Padding="12,0,4,0"><TextBlock x:Name="SidebarTitle" Text="PROJEKT" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80"/><Button HorizontalAlignment="Right" Click="ToggleSidebar" Content="‹" AutomationProperties.Name="Projektpanel elrejtése"/></Grid>
    <Grid Grid.Row="1" x:Name="ProjectPane"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="FilenameFilter" Margin="8,2,8,8" PlaceholderText="Fájlnévszűrés" TextChanged="FilterChanged" KeyDown="FilterKeyDown" AutomationProperties.Name="Projektfájl nevének szűrése"/><TreeView x:Name="Files" Grid.Row="1" ItemInvoked="ProjectItemInvoked" SelectionMode="Single" Background="Transparent" Foreground="{ThemeResource IdeTextBrush}"/></Grid>
    <StackPanel Grid.Row="1" x:Name="AgentPane" Visibility="Collapsed" Padding="14,8" Spacing="12"><TextBlock Text="HELYI MCP" FontWeight="SemiBold" Foreground="{ThemeResource IdeAccentBrush}"/><TextBlock x:Name="AgentDescription" Text="Nyiss meg egy projektet a helyi agentmunkamenethez." TextWrapping="Wrap"/><Button x:Name="MCPButton" Content="Konfiguráció másolása" Click="CopyMCP" IsEnabled="False"/><TextBlock Text="A helyi agent közvetlenül szerkeszthet és menthet. Módosításai a közös előzményben visszavonhatók." TextWrapping="Wrap" Foreground="{ThemeResource IdeSecondaryBrush}"/></StackPanel>
    <Border Grid.Row="2" Padding="10,8" BorderBrush="{ThemeResource IdeBorderBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="RetainedLabel" Text="0 / 10 megőrzött dokumentum" FontSize="10" Foreground="{ThemeResource IdeSecondaryBrush}" TextWrapping="Wrap"/></Border>
   </Grid>
   <primitives:Thumb Grid.Column="2" x:Name="SidebarDivider" Background="{ThemeResource IdeBorderBrush}" DragDelta="ResizeSidebar" AutomationProperties.Name="Projektpanel szélessége"/>
   <Grid Grid.Column="3" x:Name="WorkArea"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="OutputDividerRow" Height="4"/><RowDefinition x:Name="OutputRow" Height="154"/></Grid.RowDefinitions>
    <Grid x:Name="DocumentWorkspace"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SourceColumn" Width="*"/><ColumnDefinition x:Name="PreviewDividerColumn" Width="4"/><ColumnDefinition x:Name="PreviewColumn" Width="0.78*"/></Grid.ColumnDefinitions>
     <Grid Background="{ThemeResource IdeEditorBrush}"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TabView x:Name="DocumentTabs" Height="36" IsAddTabButtonVisible="False" CanReorderTabs="False" TabWidthMode="SizeToContent" TabCloseRequested="HideTab" SelectionChanged="TabSelected" Background="{ThemeResource IdePanelBrush}"/>
      <Border Grid.Row="1" BorderBrush="{ThemeResource IdeBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0"><Grid><TextBlock x:Name="Breadcrumb" Text="LaTeX IDE" Foreground="{ThemeResource IdeSecondaryBrush}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/><Button Content="Keresés" Click="ShowFind" HorizontalAlignment="Right" FontSize="10" ToolTipService.ToolTip="Keresés a forrásban · Ctrl+F"/></Grid></Border>
      <Grid Grid.Row="2" x:Name="FindBar" Visibility="Collapsed" Background="{ThemeResource IdePanelBrush}" Padding="8,5" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FindQuery" PlaceholderText="Keresés a szövegben · kis/nagybetű számít" KeyDown="FindKeyDown"/><Button Grid.Column="1" Content="↑" Click="FindPrevious" AutomationProperties.Name="Előző találat"/><Button Grid.Column="2" Content="↓" Click="FindNext" AutomationProperties.Name="Következő találat"/><Button Grid.Column="3" Content="×" Click="HideFind" AutomationProperties.Name="Keresősáv bezárása"/></Grid>
      <Grid Grid.Row="3" x:Name="EditorHost"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Canvas x:Name="Gutter" Background="{ThemeResource IdeEditorBrush}" IsHitTestVisible="False"/><Canvas Grid.Column="1" x:Name="CurrentLineLayer" IsHitTestVisible="False"><Border x:Name="CurrentLine" Background="{ThemeResource IdeCurrentLineBrush}"/></Canvas>
       <RichEditBox x:Name="Editor" Grid.Column="1" AcceptsReturn="True" IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="8,5,8,12" Background="Transparent" Foreground="{ThemeResource IdeTextBrush}" BorderThickness="0" CornerRadius="0" ClipboardCopyFormat="PlainText" AllowDrop="False" TextChanged="TextChanged" SelectionChanged="EditorSelectionChanged" TextCompositionStarted="CompositionStarted" TextCompositionEnded="CompositionEnded" PreviewKeyDown="EditorKeyDown" Paste="PlainTextPaste" Drop="RejectRichDrop" SizeChanged="EditorSizeChanged"/>
       <StackPanel x:Name="EmptyState" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="340" Margin="24"><TextBlock Text="LATEX IDE" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource IdeSecondaryBrush}"/><TextBlock Text="Helyi forrás. Natív munkaterület." Foreground="{ThemeResource IdeSecondaryBrush}"/><Button Content="Projektmappa megnyitása…" Click="OpenProject" HorizontalAlignment="Left"/><TextBlock Text="Ctrl+P   Fájl megnyitása&#xA;Ctrl+F   Keresés a forrásban&#xA;Ctrl+S   Mentés&#xA;Ctrl+B   Fordítás" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource IdeSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </Grid>
     <primitives:Thumb x:Name="PreviewDivider" Grid.Column="1" Background="{ThemeResource IdeBorderBrush}" DragDelta="ResizePreview" AutomationProperties.Name="Forrás és PDF szélességaránya"/>
     <Grid x:Name="PDFPane" Grid.Column="2" Background="{ThemeResource IdePanelBrush}"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Padding="10,0,4,0"><TextBlock Text="PDF ELŐNÉZET" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="−" Click="ZoomOut" ToolTipService.ToolTip="PDF kicsinyítése"/><Button Content="+" Click="ZoomIn" ToolTipService.ToolTip="PDF nagyítása"/><Button Content="×" Click="TogglePreview" ToolTipService.ToolTip="PDF elrejtése"/></StackPanel></Grid>
      <Grid Grid.Row="1" Padding="8,0" Background="{ThemeResource IdeChromeBrush}"><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="‹" Click="PreviousPage" AutomationProperties.Name="Előző PDF-oldal"/><TextBlock x:Name="PageLabel" Text="Nincs PDF" VerticalAlignment="Center" Foreground="{ThemeResource IdeSecondaryBrush}"/><Button Content="›" Click="NextPage" AutomationProperties.Name="Következő PDF-oldal"/></StackPanel><TextBlock x:Name="PDFState" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource IdeSecondaryBrush}" Text="Még nem fordult"/></Grid>
      <ScrollViewer x:Name="PDFScroll" Grid.Row="2" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="16"><Image x:Name="Preview" Stretch="Uniform" VerticalAlignment="Top"/></ScrollViewer>
     </Grid>
    </Grid>
    <primitives:Thumb x:Name="OutputDivider" Grid.Row="1" Background="{ThemeResource IdeBorderBrush}" DragDelta="ResizeOutput" AutomationProperties.Name="Kimeneti panel magassága"/>
    <Grid x:Name="OutputPane" Grid.Row="2" Background="{ThemeResource IdePanelBrush}"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid BorderBrush="{ThemeResource IdeBorderBrush}" BorderThickness="0,0,0,1" Padding="8,0"><StackPanel Orientation="Horizontal" Spacing="4"><Button x:Name="DiagnosticsButton" Content="Problémák · 0" Click="ShowDiagnostics"/><Button x:Name="CompilerOutputButton" Content="Fordítási kimenet" Click="ShowCompilerOutput"/><TextBlock x:Name="OutputState" Text="Nincs fordítási eredmény" Foreground="{ThemeResource IdeSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0"/></StackPanel><Button HorizontalAlignment="Right" Content="×" Click="ToggleOutput" AutomationProperties.Name="Kimeneti panel elrejtése"/></Grid>
     <ScrollViewer Grid.Row="1" x:Name="LogScroll" Padding="12,8" HorizontalScrollBarVisibility="Auto"><TextBlock x:Name="Log" Text="A helyi fordító kimenete itt jelenik meg." FontFamily="Cascadia Mono, Consolas" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="NoWrap"/></ScrollViewer><ScrollViewer Grid.Row="1" x:Name="DiagnosticsScroll" Visibility="Collapsed" Padding="12,8"><TextBlock x:Name="DiagnosticsText" Text="Nincs fordítási diagnosztika." FontFamily="Cascadia Mono, Consolas" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="Wrap"/></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{ThemeResource IdeChromeBrush}" BorderBrush="{ThemeResource IdeBorderBrush}" BorderThickness="0,1,0,0"><Grid Padding="8,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Kimenet" Click="ToggleOutput" FontSize="10" Padding="3,0" MinHeight="20"/><TextBlock Grid.Column="1" x:Name="Status" Text="Nyiss meg egy helyi projektmappát." TextTrimming="CharacterEllipsis" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource IdeSecondaryBrush}"/><TextBlock Grid.Column="2" x:Name="CaretLabel" Text="—" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="3" x:Name="EncodingLabel" Text="UTF-8" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="4" x:Name="EOLLabel" Text="—" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="5" x:Name="BuildState" Text="Nincs projekt" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="6" x:Name="AgentState" Text="MCP: nincs munkamenet" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource IdeSecondaryBrush}"/></Grid></Border>
 </Grid>
</Window>
